---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CONTACT_URL, checkoutValueFlow, skanpayFlow } from "../content/site";
---
<BaseLayout
  title="SkanPay - Checkout Value Platform"
  description="SkanPay helps participating wallets, merchants, and payment partners apply eligible value before the final balance is paid."
  activePath="/qr-payments/"
>
  <section class="product-hero skanpay-page">
    <div class="product-hero-inner">
      <div class="product-hero-copy motion-item">
        <p class="eyebrow">SkanPay</p>
        <h1>Make existing value usable at checkout.</h1>
        <p class="hero-lede">
          SkanPay is the broader product direction behind BeamCash: a patent-pending checkout value platform for participating wallets, merchants, payment partners, and promotion programs.
        </p>
        <div class="hero-checks" aria-label="SkanPay partner fit">
          <span>Value before final payment</span>
          <span>Merchant checkout stays in control</span>
          <span>Pilot-first partner path</span>
        </div>
        <div class="product-actions">
          <a class="button primary" href={CONTACT_URL}>Discuss a pilot</a>
          <a class="button secondary" href="/beamcash-demo/">See the demo product</a>
        </div>
      </div>

      <aside class="checkout-layer-scene motion-item" aria-label="SkanPay checkout value layer">
        <div class="layer-heading">
          <span>Checkout value layer</span>
          <strong>Apply value first. Pay the remaining balance.</strong>
        </div>

        <div class="layer-diagram">
          <article class="layer-card">
            <span>Value source</span>
            <strong>Offer, wallet, loyalty, or voucher</strong>
          </article>
          <div class="layer-connector" aria-hidden="true"></div>
          <article class="layer-card active">
            <span>Merchant checkout</span>
            <strong>Eligibility and balance calculation</strong>
          </article>
          <div class="layer-connector" aria-hidden="true"></div>
          <article class="layer-card">
            <span>Payment path</span>
            <strong>Customer pays what remains</strong>
          </article>
        </div>

        <div class="layer-result">
          <span>Result</span>
          <strong>Value applied. Final balance paid. Confirmation returned.</strong>
        </div>
      </aside>
    </div>
  </section>

  <section class="step-band" aria-label="SkanPay checkout flow">
    <div class="step-band-inner">
      {skanpayFlow.map((step, index) => (
        <article class="motion-item">
          <span>{String(index + 1).padStart(2, "0")}</span>
          <strong>{step}</strong>
        </article>
      ))}
    </div>
  </section>

  <section class="checkout-value-section">
    <div class="product-section-inner">
      <div class="section-intro motion-item">
        <span>SkanPay role</span>
        <h2>A coordination layer for checkout value.</h2>
        <p>SkanPay helps participating systems identify eligible value, apply merchant rules, complete the remaining payment, and return a clear confirmation.</p>
      </div>

      <div class="checkout-value-rail" aria-label="SkanPay checkout value sequence">
        {checkoutValueFlow.map((step, index) => (
          <article class="motion-item">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{step.label}</strong>
            <p>{step.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="pilot-section">
    <div class="product-section-inner">
      <div class="section-intro motion-item">
        <span>Partner fit</span>
        <h2>Start with one narrow checkout problem.</h2>
        <p>A useful first pilot should define the value source, merchant setting, payment path, confirmation needs, and success measure before anything expands.</p>
      </div>

      <div class="pilot-ledger" aria-label="SkanPay pilot structure">
        <article class="motion-item">
          <span>01</span>
          <strong>Wallet or offer owner</strong>
          <p>Make existing customer value usable in a participating checkout.</p>
        </article>
        <article class="motion-item">
          <span>02</span>
          <strong>Merchant or platform</strong>
          <p>Keep invoice logic, eligibility, and operations in the systems that own checkout.</p>
        </article>
        <article class="motion-item">
          <span>03</span>
          <strong>Payment partner</strong>
          <p>Evaluate a repeatable checkout pattern instead of one-off integrations.</p>
        </article>
      </div>

      <div class="pilot-brief motion-item" aria-label="Pilot scope checklist">
        <span>Pilot scope</span>
        <strong>One value source. One merchant environment. One payment path. One measurable checkout result.</strong>
      </div>
    </div>
  </section>

  <section class="final-cta">
    <div class="final-cta-inner">
      <div>
        <span>Next step</span>
        <h2>Have a value-at-checkout problem to test?</h2>
        <p>Share the wallet, merchant, offer, or payment workflow you want to make simpler.</p>
      </div>
      <div class="cta-group">
        <a class="button primary" href={CONTACT_URL}>Contact SkanPay</a>
        <a class="button ghost" href="/beamcash-demo/">View BeamCash demo</a>
      </div>
    </div>
  </section>
</BaseLayout>
