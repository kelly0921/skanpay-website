---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="About - SkanPay"
  description="Learn about SkanPay's patent-pending QR checkout work and the team building BeamCash as product proof."
  activePath="/about/"
>
  <section class="page-hero">
    <p class="eyebrow">About SkanPay</p>
    <h1>Focused on practical QR checkout infrastructure</h1>
    <p>SkanPay combines patent-pending payment gateway work with BeamCash, a product demo for the seller-to-buyer handoff.</p>
  </section>

  <section class="section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Team</p>
        <h2>Payment, product, and business coverage</h2>
      </div>
      <p>A compact team building from payment-domain knowledge, implementation, and market-facing communication.</p>
    </div>
    <div class="team-grid">
      <article class="team-card">
        <div class="avatar-placeholder" aria-hidden="true">KC</div>
        <span>Product and implementation</span>
        <h3>Kelly Chen</h3>
        <p>Kelly leads product direction, user experience, and BeamCash implementation as proof for the SkanPay model.</p>
      </article>
      <article class="team-card">
        <div class="avatar-placeholder" aria-hidden="true">BC</div>
        <span>Payment expertise</span>
        <h3>Bilin Chen</h3>
        <p>Bilin brings payment-industry knowledge across gateway models, merchant acceptance, and transaction operations.</p>
      </article>
      <article class="team-card">
        <div class="avatar-placeholder" aria-hidden="true">ZL</div>
        <span>Business and market development</span>
        <h3>Zoe Lu</h3>
        <p>Zoe supports business development, market research, and partner-facing communication.</p>
      </article>
    </div>
  </section>

  <section class="section patent-band">
    <div>
      <p class="eyebrow">Invention</p>
      <h2>Patent-pending payment and redemption work</h2>
      <p>
        SkanPay has pending patent work related to QR acceptance, checkout coordination, buyer approval, seller confirmation, and coupon or voucher redemption.
      </p>
    </div>
    <a class="button primary" href="/contact/">Discuss SkanPay</a>
  </section>
</BaseLayout>
