---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CONTACT_URL, FEEDBACK_FORM_URL, INTEREST_LIST_URL, beamcashFlow } from "../content/site";
---
<BaseLayout
  title="BeamCash Demo - SkanPay"
  description="BeamCash is SkanPay's small-seller QR checkout demo for showing a code, buyer review, and seller confirmation."
  activePath="/beamcash-demo/"
>
  <section class="product-hero beamcash-page">
    <div class="product-hero-inner">
      <div class="product-hero-copy motion-item">
        <img class="beam-wordmark" src="/beamcash/beamcash-wordmark.svg" alt="BeamCash" />
        <p class="eyebrow">BeamCash by SkanPay</p>
        <h1>A QR checkout demo for small sellers.</h1>
        <p class="hero-lede">
          BeamCash shows the payment moment in the simplest possible way: a seller displays a code, a buyer reviews the details, and the seller sees a clear status.
        </p>

        <div class="hero-checks" aria-label="BeamCash product outcomes">
          <span>Visible QR checkout</span>
          <span>Buyer review before payment</span>
          <span>Seller confirmation status</span>
        </div>

        <div class="product-actions">
          <a class="button primary premium-primary" href="#walkthrough">See the flow</a>
          <a class="button secondary premium-secondary" href={FEEDBACK_FORM_URL}>Give feedback</a>
        </div>
      </div>

      <aside class="beamcash-qr-scene motion-item" aria-label="BeamCash QR checkout scene">
        <div class="seller-placard">
          <span>Seller display</span>
          <strong>Scan to pay</strong>
          <img src="/beamcash/beamcash-app-seller-code.png" alt="BeamCash seller QR code screen" />
        </div>
        <img class="buyer-phone" src="/beamcash/beamcash-app-buyer-checkout.png" alt="BeamCash buyer checkout review screen" />
        <div class="seller-status">
          <span>Seller view</span>
          <strong>Waiting for buyer review</strong>
        </div>
      </aside>
    </div>
  </section>

  <section class="step-band beamcash-steps" aria-label="BeamCash checkout flow">
    <div class="step-band-inner">
      {beamcashFlow.map((step, index) => (
        <article class="motion-item">
          <span>{String(index + 1).padStart(2, "0")}</span>
          <strong>{step}</strong>
        </article>
      ))}
    </div>
  </section>

  <section class="demo-purpose-strip">
    <div class="demo-purpose-inner">
      <div>
        <span>Why BeamCash exists</span>
        <h2>It makes the checkout experience easy to see and test.</h2>
      </div>
      <p>
        BeamCash is not the full SkanPay platform. It is the learning product for seller setup, scan behavior, buyer trust, confirmation, duplicate handling, and other real checkout moments.
      </p>
    </div>
  </section>

  <section class="beam-walkthrough product-walkthrough" id="walkthrough">
    <div class="product-section-inner">
      <div class="section-intro motion-item">
        <span>How it works</span>
        <h2>Create a code. Let the buyer review. Confirm the result.</h2>
        <p>The demo keeps the seller and buyer experience easy to see, even while the payment details are still being refined.</p>
      </div>

      <div class="demo-screen-row motion-item" aria-label="BeamCash app walkthrough screens">
          <figure>
            <img src="/beamcash/beamcash-app-seller-dashboard.png" alt="BeamCash seller dashboard screen" />
            <figcaption>Seller starts</figcaption>
          </figure>
          <figure>
            <img src="/beamcash/beamcash-app-seller-code.png" alt="BeamCash seller Scan to Pay QR code screen" />
            <figcaption>QR is shown</figcaption>
          </figure>
          <figure>
            <img src="/beamcash/beamcash-app-buyer-checkout.png" alt="BeamCash buyer checkout screen" />
            <figcaption>Buyer reviews</figcaption>
          </figure>
      </div>
    </div>
  </section>

  <section class="placement-story">
    <div class="placement-story-inner">
      <div class="placement-copy motion-item">
        <span>Where the QR lives</span>
        <h2>Designed for a real counter, table, booth, or event.</h2>
        <p>Like a simple sign or checkout placard, the code should be easy to find while the buyer still sees who they are paying and what happens next.</p>
      </div>

      <div class="placement-list" aria-label="BeamCash seller use cases">
        <article class="motion-item"><span>01</span><strong>Pop-up vendors</strong></article>
        <article class="motion-item"><span>02</span><strong>Creators</strong></article>
        <article class="motion-item"><span>03</span><strong>Student fundraisers</strong></article>
        <article class="motion-item"><span>04</span><strong>Local events</strong></article>
        <article class="motion-item"><span>05</span><strong>Small service sellers</strong></article>
      </div>
    </div>
  </section>

  <section class="demo-validation">
    <div class="demo-validation-inner">
      <div class="validation-copy motion-item">
        <span>What the demo proves</span>
        <h2>BeamCash is a product test under SkanPay.</h2>
        <p>It helps us learn from the details that make a payment flow feel trustworthy in the real world.</p>
      </div>
      <div class="validation-lines" aria-label="BeamCash product learning areas">
        <div class="motion-item">
          <span>Buyer confidence</span>
          <strong>Who am I paying, and what amount am I approving?</strong>
        </div>
        <div class="motion-item">
          <span>Seller clarity</span>
          <strong>Did the scan become a payment action I can trust?</strong>
        </div>
        <div class="motion-item">
          <span>Partner proof</span>
          <strong>Can the checkout state be explained, measured, and improved?</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="beam-final-cta">
    <div class="beam-final-cta-inner">
      <div>
        <span>Feedback</span>
        <h2>Help us make the demo clearer.</h2>
      </div>
      <div class="cta-group">
        <a class="button primary" href={FEEDBACK_FORM_URL}>Give feedback</a>
        <a class="button ghost" href={INTEREST_LIST_URL}>Join interest list</a>
        <a class="button ghost" href={CONTACT_URL}>Request a conversation</a>
      </div>
    </div>
  </section>
</BaseLayout>
