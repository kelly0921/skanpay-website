---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CONTACT_URL, FEEDBACK_FORM_URL, INTEREST_LIST_URL, beamcashFlow } from "../content/site";
---
<BaseLayout
  title="BeamCash Demo - SkanPay"
  description="BeamCash is the SkanPay product proof for QR payment requests, buyer review, and seller-readable checkout status."
  activePath="/beamcash-demo/"
>
  <section class="beam-landing">
    <div class="beam-landing-inner">
      <div class="beam-hero-copy motion-item">
        <img class="beam-wordmark" src="/beamcash/beamcash-wordmark.svg" alt="BeamCash" />
        <p class="brand-kicker">BeamCash by SkanPay</p>
        <h1>BeamCash makes SkanPay visible.</h1>
        <p class="premium-lead">
          The demo shows the simplest payment moment: seller displays a QR request, buyer reviews the amount, seller gets a readable status.
        </p>
        <div class="scan-principles">
          <span>Seller QR</span>
          <span>Buyer review</span>
          <span>Status result</span>
        </div>
        <div class="premium-actions">
          <a class="button primary premium-primary" href="#walkthrough">See the flow</a>
          <a class="button secondary premium-secondary" href={FEEDBACK_FORM_URL}>Give feedback</a>
        </div>
      </div>

      <aside class="beam-stage-field motion-item" aria-label="BeamCash app screens">
        <div class="beam-stage-ribbon">Ready for buyer review</div>
        <img class="beam-stage-phone beam-stage-code" src="/beamcash/beamcash-app-seller-code.png" alt="BeamCash seller Scan to Pay QR code screen" />
        <img class="beam-stage-phone beam-stage-buyer" src="/beamcash/beamcash-app-buyer-checkout.png" alt="BeamCash checkout screen with merchant profile and payment amount options" />
        <div class="beam-stage-line" aria-hidden="true"></div>
      </aside>
    </div>
  </section>

  <section class="demo-purpose-strip">
    <div class="demo-purpose-inner">
      <div>
        <span>Why BeamCash exists</span>
        <h2>It proves the user experience, not the whole infrastructure.</h2>
      </div>
      <p>
        BeamCash is the proof product under SkanPay. It helps sellers, merchants, and payment partners see the checkout handoff before technical integration conversations go deeper.
      </p>
    </div>
  </section>

  <section class="beam-walkthrough" id="walkthrough">
    <div class="beam-walkthrough-inner">
      <div class="walkthrough-heading motion-item">
        <span>How it works</span>
        <h2>Three screens explain the payment handoff.</h2>
        <p>Seller shows the request. Buyer checks the details. Seller sees the result.</p>
      </div>

      <div class="demo-flow-editorial">
        <div class="demo-screen-stack motion-item" aria-label="BeamCash app walkthrough screens">
          <figure>
            <img src="/beamcash/beamcash-app-seller-dashboard.png" alt="BeamCash seller dashboard screen" />
            <figcaption>Seller starts</figcaption>
          </figure>
          <figure>
            <img src="/beamcash/beamcash-app-seller-code.png" alt="BeamCash seller Scan to Pay QR code screen" />
            <figcaption>QR is shown</figcaption>
          </figure>
          <figure>
            <img src="/beamcash/beamcash-app-buyer-checkout.png" alt="BeamCash buyer checkout screen" />
            <figcaption>Buyer reviews</figcaption>
          </figure>
        </div>

        <div class="demo-flow-lines" aria-label="BeamCash checkout steps">
          {beamcashFlow.map((step, index) => (
            <article class="motion-item">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{step}</strong>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="placement-story">
    <div class="placement-story-inner">
      <div class="placement-copy motion-item">
        <span>Where the QR lives</span>
        <h2>Designed for a real counter, table, booth, or event.</h2>
        <p>The QR should be easy to scan, but the checkout still needs merchant, amount, and status context.</p>
      </div>

      <div class="placement-marquee" aria-label="BeamCash seller use cases">
        <span>Pop-up vendors</span>
        <span>Creators</span>
        <span>Student fundraisers</span>
        <span>Local events</span>
        <span>Small service sellers</span>
      </div>
    </div>
  </section>

  <section class="beam-final-cta">
    <div class="beam-final-cta-inner">
      <div>
        <span>Feedback</span>
        <h2>Help us refine the demo flow.</h2>
      </div>
      <div class="cta-group">
        <a class="button primary" href={FEEDBACK_FORM_URL}>Give feedback</a>
        <a class="button ghost" href={INTEREST_LIST_URL}>Join interest list</a>
        <a class="button ghost" href={CONTACT_URL}>Request a conversation</a>
      </div>
    </div>
  </section>
</BaseLayout>
