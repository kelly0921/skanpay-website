---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CONTACT_URL, FEEDBACK_FORM_URL, INTEREST_LIST_URL } from "../content/site";
---
<BaseLayout
  title="BeamCash Demo - SkanPay"
  description="BeamCash is the SkanPay product demo for seller setup, Scan to Pay QR, buyer amount review, and checkout status."
  activePath="/beamcash-demo/"
>
  <section class="app-product-hero">
    <div class="app-hero-inner">
      <div class="app-hero-copy">
        <div class="app-logo-block square-logo-block">
          <img class="beamcash-brand-icon" src="/beamcash/beamcash-logo-mark.svg" alt="BeamCash logo" />
        </div>
        <p class="page-label">BeamCash demo</p>
        <h1>Scan-to-pay checkout, shown through the critical screens.</h1>
        <p class="lead-copy">
          BeamCash turns the SkanPay handoff into something reviewable: seller setup, Scan to Pay QR, buyer amount review, and checkout status.
        </p>
        <div class="hero-proof hero-proof-dark">
          <span>Seller surface</span>
          <span>Buyer review</span>
          <span>Status handoff</span>
        </div>
        <div class="button-row">
          <a class="button primary" href={INTEREST_LIST_URL}>Join interest list</a>
          <a class="button secondary" href="#walkthrough">Review demo</a>
        </div>
      </div>

      <aside class="app-screen-hero" aria-label="BeamCash app screens">
        <img src="/beamcash/beamcash-app-seller-dashboard.png" alt="BeamCash seller dashboard with Scan to Pay QR code" />
        <img src="/beamcash/beamcash-app-buyer-checkout.png" alt="BeamCash checkout screen with merchant profile and payment amount options" />
      </aside>
    </div>
  </section>

  <section class="section demo-purpose">
    <div class="section-inner demo-purpose-inner">
      <div>
        <span>Why BeamCash exists</span>
        <h2>Concrete screens make the gateway easier to evaluate.</h2>
      </div>
      <p>
        Instead of asking partners to imagine the checkout layer, BeamCash shows the seller view, buyer approval surface, and status boundary.
      </p>
    </div>
  </section>

  <section class="section app-flow-section" id="walkthrough">
    <div class="section-inner">
      <div class="section-heading">
        <span>Demo walkthrough</span>
        <h2>Three screens, one payment handoff.</h2>
      </div>
      <div class="app-flow-row">
        <article>
          <img src="/beamcash/beamcash-app-seller-dashboard.png" alt="BeamCash seller dashboard screen" />
          <span>01 / Set up</span>
          <h3>Prepare the seller surface</h3>
          <p>The seller sees balance, payout readiness, activity, and the payment code area.</p>
        </article>
        <article>
          <img src="/beamcash/beamcash-app-seller-code.png" alt="BeamCash seller Scan to Pay QR code screen" />
          <span>02 / Present</span>
          <h3>Show the Scan to Pay code</h3>
          <p>The QR screen carries merchant identity, code actions, and alert preferences.</p>
        </article>
        <article>
          <img src="/beamcash/beamcash-app-buyer-checkout.png" alt="BeamCash buyer checkout screen" />
          <span>03 / Review</span>
          <h3>Confirm seller and amount</h3>
          <p>The buyer reviews the merchant profile and amount before continuing to secure checkout.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section demo-use-section">
    <div class="section-inner demo-use-inner">
      <div class="demo-use-copy">
        <span>Business use</span>
        <h2>Use BeamCash to evaluate the handoff.</h2>
        <p>BeamCash keeps the conversation grounded in visible screens instead of abstract gateway diagrams.</p>
      </div>
      <div class="use-list">
        <div>
          <strong>Seller signals</strong>
          <p>What must the seller know before and after a buyer scans?</p>
        </div>
        <div>
          <strong>Buyer trust</strong>
          <p>Is the merchant, amount, and approval action clear enough?</p>
        </div>
        <div>
          <strong>Partner boundary</strong>
          <p>Where do wallet, redemption, processor, and support roles sit?</p>
        </div>
      </div>
    </div>
  </section>

  <section class="business-cta">
    <div class="business-cta-inner">
      <div>
        <span>Feedback</span>
        <h2>Evaluate BeamCash with us.</h2>
      </div>
      <div class="cta-group">
        <a class="button primary" href={FEEDBACK_FORM_URL}>Give feedback</a>
        <a class="button ghost" href={CONTACT_URL}>Request a conversation</a>
      </div>
    </div>
  </section>
</BaseLayout>
