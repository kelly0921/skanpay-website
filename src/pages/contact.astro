---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CONTACT_EMAIL, CONTACT_URL } from "../content/site";
---
<BaseLayout
  title="Contact - SkanPay"
  description="Contact SkanPay to review a QR checkout, wallet, redemption, merchant, or BeamCash product conversation."
  activePath="/contact/"
>
  <section class="page-hero">
    <p class="eyebrow">Contact</p>
    <h1>Talk through a checkout handoff</h1>
    <p>Share the seller, buyer, wallet, redemption, or partner context you want SkanPay to review.</p>
  </section>

  <section class="section contact-grid">
    <div class="split-panel">
      <h2>Useful context to include</h2>
      <p>The clearest inquiries describe the checkout moment, who participates, and what status needs to return.</p>
      <div class="contact-checklist">
        <span>Seller type</span>
        <span>Buyer payment path</span>
        <span>Wallet or partner role</span>
        <span>Redemption or offer need</span>
      </div>
      <p><strong>Email:</strong> <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
    </div>

    <form class="contact-form" action={CONTACT_URL} method="post" enctype="text/plain">
      <div class="field-grid">
        <label>
          Name
          <input type="text" name="name" autocomplete="name" required />
        </label>
        <label>
          Email
          <input type="email" name="email" autocomplete="email" required />
        </label>
      </div>
      <label>
        Company
        <input type="text" name="company" autocomplete="organization" />
      </label>
      <label>
        Inquiry type
        <select name="inquiry_type" required>
          <option value="">Select an inquiry type</option>
          <option>Merchant or seller checkout</option>
          <option>Wallet or payment app partnership</option>
          <option>Coupon, voucher, or redemption</option>
          <option>BeamCash product feedback</option>
          <option>General cooperation</option>
        </select>
      </label>
      <label>
        Message
        <textarea name="message" required></textarea>
      </label>
      <p class="form-note">This opens an email draft to {CONTACT_EMAIL}. A connected form endpoint can be added later.</p>
      <button class="button primary" type="submit">Send inquiry</button>
    </form>
  </section>
</BaseLayout>
