---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  CONTACT_URL,
  FEEDBACK_FORM_URL,
  INTEREST_LIST_URL,
  PRODUCT_STATUS,
  beamcashFlow,
  beamcashHighlights,
  faqs,
  painSolutions,
  productDirections,
  roadmapItems,
  skanpayFlow,
  useCases
} from "../content/site";
---
<BaseLayout
  title="SkanPay - BeamCash QR Payments"
  description="SkanPay is the broader QR payment and redemption vision. BeamCash is a QR-first payment product direction for small sellers and real-world transactions."
  activePath="/"
>
  <section class="landing-hero">
    <div class="hero-inner">
      <div class="hero-content">
        <p class="hero-eyebrow">SkanPay presents BeamCash</p>
        <h1>QR checkout for sellers who cannot rely on cash.</h1>
        <p class="hero-subhead">
          BeamCash is the focused product demo: a seller shows a QR code, a buyer reviews the payment, and both sides get a clearer checkout moment.
        </p>

        <div class="hero-proof">
          <span>No heavy storefront</span>
          <span>Buyer-first checkout</span>
          <span>Built for real-world selling</span>
        </div>

        <div class="hero-actions">
          <a class="button primary" href={INTEREST_LIST_URL}>Join interest list</a>
          <a class="button secondary" href="/beamcash-demo/">View BeamCash demo</a>
        </div>

        <div class="status-note">
          <span>{PRODUCT_STATUS.label}</span>
          <p>{PRODUCT_STATUS.detail}</p>
        </div>
      </div>

      <aside class="hero-product" aria-label="BeamCash prototype screens">
        <div class="product-window">
          <div class="product-window-top">
            <img src="/beamcash/beamcash-wordmark.svg" alt="BeamCash" />
            <span>Seller QR to buyer checkout</span>
          </div>
          <div class="screen-showcase">
            <img src="/beamcash/beamcash-seller-dashboard-mobile.png" alt="BeamCash seller dashboard with QR code and activity status" />
            <img src="/beamcash/beamcash-buyer-checkout-mobile.png" alt="BeamCash buyer checkout screen with merchant and amount details" />
          </div>
          <div class="product-steps" aria-label="BeamCash checkout sequence">
            <span>Show QR</span>
            <span>Buyer reviews</span>
            <span>Confirm result</span>
          </div>
          <p>Prototype screens shown for product conversations.</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section pain-section">
    <div class="section-inner">
      <div class="section-heading">
        <span>The problem</span>
        <h2>Small payments break down when checkout feels bigger than the sale.</h2>
      </div>
      <div class="pain-grid">
        {painSolutions.map((item) => (
          <article>
            <strong>{item.pain}</strong>
            <p>{item.response}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section beamcash-section" id="beamcash">
    <div class="section-inner beamcash-layout">
      <div class="beamcash-visual" aria-label="BeamCash mobile flow preview">
        <img src="/beamcash/beamcash-find-code-mobile.png" alt="BeamCash QR code lookup screen" />
        <img src="/beamcash/beamcash-buyer-checkout-mobile.png" alt="BeamCash buyer checkout screen" />
      </div>

      <div>
        <div class="section-heading">
          <span>BeamCash</span>
          <h2>A simple product surface for everyday sellers.</h2>
          <p>
            BeamCash turns the SkanPay idea into something people can see, test, and react to before deeper bank, merchant, or partner requirements are finalized.
          </p>
        </div>

        <div class="flow-list compact-flow" aria-label="BeamCash flow">
          {beamcashFlow.map((step, index) => (
            <div>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{step}</strong>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="section-inner feature-row">
      {beamcashHighlights.map((feature) => (
        <article>
          <h3>{feature.title}</h3>
          <p>{feature.copy}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section skanpay-section" id="skanpay">
    <div class="section-inner skanpay-layout">
      <div class="section-heading">
        <span>SkanPay</span>
        <h2>The broader QR payment and redemption system.</h2>
        <p>
          SkanPay is the company and patent-pending invention behind the larger vision: one checkout request that can coordinate payment, coupon, voucher, reward, or stored-value redemption.
        </p>
      </div>

      <div class="platform-flow" aria-label="SkanPay checkout direction">
        {skanpayFlow.map((step, index) => (
          <article>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{step}</strong>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section use-case-section">
    <div class="section-inner">
      <div class="section-heading">
        <span>Where it fits</span>
        <h2>One company, two levels of conversation.</h2>
      </div>
      <div class="fit-grid">
        {productDirections.map((product) => (
          <article>
            <span>{product.name}</span>
            <h3>{product.label}</h3>
            <p>{product.description}</p>
            <ul>
              {product.bestFor.slice(0, 4).map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section status-faq-section" id="status">
    <div class="section-inner status-layout">
      <div>
        <div class="section-heading">
          <span>Current status</span>
          <h2>Prototype now. Feedback next.</h2>
          <p>
            The website should help people understand the direction quickly, then open the right conversation with sellers, merchants, partners, and investors.
          </p>
        </div>
        <div class="roadmap-list">
          {roadmapItems.slice(0, 4).map((item) => (
            <div>
              <span>{item.status}</span>
              <strong>{item.title}</strong>
            </div>
          ))}
        </div>
      </div>

      <div>
        <div class="section-heading small-heading">
          <span>FAQ</span>
          <h2>Quick answers.</h2>
        </div>
        <div class="faq-list">
          {faqs.slice(0, 4).map((faq) => (
            <details>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="final-cta" id="contact">
    <div class="final-cta-inner">
      <div>
        <span>Next step</span>
        <h2>Help shape the QR checkout flow.</h2>
        <p>Join the interest list, send product feedback, or start a SkanPay conversation.</p>
      </div>
      <div class="cta-group">
        <a class="button primary" href={INTEREST_LIST_URL}>Join interest list</a>
        <a class="button secondary" href={FEEDBACK_FORM_URL}>Give feedback</a>
        <a class="button ghost" href={CONTACT_URL}>Contact us</a>
      </div>
    </div>
  </section>
</BaseLayout>
