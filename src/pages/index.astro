---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  CONTACT_URL,
  beamcashFlow,
  checkoutProblems,
  relationshipMap,
  skanpayFlow
} from "../content/site";
---
<BaseLayout
  title="SkanPay - Apply Offers and Pay in One Checkout"
  description="SkanPay helps participating wallets, merchants, and payment partners apply eligible value before final payment. BeamCash is the small-seller QR checkout demo."
  activePath="/"
>
  <section class="home-hero">
    <div class="home-hero-inner">
      <div class="home-hero-copy motion-item">
        <p class="brand-kicker">Value at checkout</p>
        <h1>Apply offers and pay in one checkout.</h1>
        <p class="premium-lead">
          SkanPay helps participating wallets, merchants, payment partners, and promotion programs connect eligible coupons, vouchers, gift cards, or loyalty value to the final payment. BeamCash is the small-seller demo that makes the checkout moment visible.
        </p>

        <div class="premium-actions">
          <a class="button primary premium-primary" href="/qr-payments/">Explore SkanPay</a>
          <a class="button secondary premium-secondary" href="/beamcash-demo/">View BeamCash demo</a>
        </div>

        <div class="scan-principles" aria-label="SkanPay payment principles">
          <span>Present offer</span>
          <span>Apply value</span>
          <span>Pay balance</span>
        </div>

        <p class="product-status-line">For the customer, it should feel like one checkout. For partners, each system keeps its role.</p>
      </div>

      <aside class="open-payment-field motion-item" aria-label="BeamCash QR checkout product scene">
        <div class="field-status-chip">
          <span>BeamCash demo</span>
          <strong>Ready for buyer review</strong>
        </div>
        <div class="scan-beam" aria-hidden="true"></div>
        <img class="field-phone field-dashboard" src="/beamcash/beamcash-app-seller-dashboard.png" alt="BeamCash seller dashboard screen" />
        <img class="field-phone field-code" src="/beamcash/beamcash-app-seller-code.png" alt="BeamCash seller Scan to Pay QR code screen" />
        <img class="field-phone field-buyer" src="/beamcash/beamcash-app-buyer-checkout.png" alt="BeamCash buyer checkout screen with seller and amount review" />
        <div class="field-state-line">
          <span>Seller</span>
          <span>Buyer</span>
          <span>Status</span>
        </div>
      </aside>
    </div>
  </section>

  <section class="relationship-section">
    <div class="relationship-inner">
      <div class="relationship-heading motion-item">
        <span>How the pieces fit</span>
        <h2>SkanPay is the company direction. BeamCash is the demo.</h2>
        <p>BeamCash shows a simple seller-to-buyer QR checkout. SkanPay is the broader partner path for making wallet and offer value work at participating merchant checkout.</p>
      </div>
      <div class="relationship-map" aria-label="SkanPay and BeamCash relationship">
        {relationshipMap.map((item, index) => (
          <article class="relationship-row motion-item">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{item.name}</strong>
            <em>{item.role}</em>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="problem-flow">
    <div class="problem-flow-inner">
      <div class="problem-heading motion-item">
        <span>The payment problem</span>
        <h2>Checkout is where stored value gets lost.</h2>
        <p>A customer may have a coupon, voucher, gift card, loyalty benefit, or payment account in one app, while the merchant invoice and payment path live somewhere else.</p>
      </div>
      <div class="problem-lines" aria-label="QR checkout problem and response">
        {checkoutProblems.map((item, index) => (
          <article class="motion-item">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div>
              <strong>{item.problem}</strong>
              <p>{item.solution}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="system-blueprint" id="skanpay">
    <div class="system-blueprint-inner">
      <div class="system-copy motion-item">
        <span>SkanPay</span>
        <h2>The SkanPay idea in one flow.</h2>
        <p>
          Present eligible value, apply it at checkout, pay the final balance, and confirm what happened. That is the public product story; the partner details can be reviewed case by case.
        </p>
      </div>

      <div class="blueprint-rail" aria-label="SkanPay checkout direction">
        {skanpayFlow.map((step, index) => (
          <article class="motion-item">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{step}</strong>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="scan-story" id="beamcash">
    <div class="scan-story-inner">
      <div class="scan-story-visual motion-item" aria-label="BeamCash screen progression">
        <img class="story-device story-device-dashboard" src="/beamcash/beamcash-app-seller-dashboard.png" alt="BeamCash seller dashboard screen" />
        <img class="story-device story-device-code" src="/beamcash/beamcash-app-seller-code.png" alt="BeamCash seller QR code screen" />
        <img class="story-device story-device-checkout" src="/beamcash/beamcash-app-buyer-checkout.png" alt="BeamCash buyer checkout screen" />
      </div>

      <div class="scan-story-copy motion-item">
        <span>BeamCash product proof</span>
        <h2>Start with the payment moment people can see.</h2>
        <p>
          BeamCash focuses on a small-seller QR checkout because it is easy to understand: show the code, let the buyer review, and return a clear status to the seller.
        </p>

        <div class="story-line-list" aria-label="BeamCash payment walkthrough">
          {beamcashFlow.map((step, index) => (
            <div>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{step}</strong>
            </div>
          ))}
        </div>

        <a class="text-link" href="/beamcash-demo/">Explore the BeamCash page</a>
      </div>
    </div>
  </section>

  <section class="final-cta" id="contact">
    <div class="final-cta-inner">
      <div>
        <span>Next step</span>
        <h2>Have a checkout or redemption problem to test?</h2>
        <p>Share the wallet, merchant, offer, or seller workflow you want to make simpler.</p>
      </div>
      <div class="cta-group">
        <a class="button primary" href={CONTACT_URL}>Contact SkanPay</a>
        <a class="button ghost" href="/beamcash-demo/">View BeamCash demo</a>
      </div>
    </div>
  </section>
</BaseLayout>
