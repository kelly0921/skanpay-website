---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  CONTACT_URL,
  INTEREST_LIST_URL,
  PRODUCT_STATUS,
  beamcashFlow,
  beamcashHighlights,
  painSolutions,
  productDirections,
  skanpayFlow
} from "../content/site";
---
<BaseLayout
  title="SkanPay - BeamCash QR Payments"
  description="SkanPay is developing QR checkout infrastructure. BeamCash is the product demo showing seller QR, buyer review, and checkout status."
  activePath="/"
>
  <section class="home-hero">
    <div class="home-hero-inner">
      <div class="home-hero-copy motion-item">
        <p class="brand-kicker">SkanPay infrastructure / BeamCash proof</p>
        <h1>Make QR checkout clear from scan to status.</h1>
        <p class="premium-lead">
          SkanPay is developing patent-pending QR checkout infrastructure for payment and redemption flows. BeamCash is the working demo that makes the seller request, buyer review, and payment status visible.
        </p>

        <div class="premium-actions">
          <a class="button primary premium-primary" href="/beamcash-demo/">View BeamCash</a>
          <a class="button secondary premium-secondary" href={CONTACT_URL}>Contact SkanPay</a>
        </div>

        <div class="scan-principles" aria-label="SkanPay payment principles">
          <span>Display QR</span>
          <span>Review amount</span>
          <span>Return status</span>
        </div>

        <p class="product-status-line">{PRODUCT_STATUS.detail}</p>
      </div>

      <aside class="open-payment-field motion-item" aria-label="BeamCash QR checkout product scene">
        <div class="field-status-chip">
          <span>BeamCash demo</span>
          <strong>Request ready for buyer review</strong>
        </div>
        <div class="scan-beam" aria-hidden="true"></div>
        <img class="field-phone field-dashboard" src="/beamcash/beamcash-app-seller-dashboard.png" alt="BeamCash seller dashboard screen" />
        <img class="field-phone field-code" src="/beamcash/beamcash-app-seller-code.png" alt="BeamCash seller Scan to Pay QR code screen" />
        <img class="field-phone field-buyer" src="/beamcash/beamcash-app-buyer-checkout.png" alt="BeamCash buyer checkout screen with seller and amount review" />
        <div class="field-state-line">
          <span>Seller</span>
          <span>Buyer</span>
          <span>Status</span>
        </div>
      </aside>
    </div>
  </section>

  <section class="pain-ledger">
    <div class="pain-ledger-inner">
      <div class="pain-ledger-heading motion-item">
        <span>The payment problem</span>
        <h2>A QR code is only useful when every party knows what happened.</h2>
      </div>
      <div class="pain-lines" aria-label="QR payment pain points and SkanPay response">
        {painSolutions.map((item, index) => (
          <article class="motion-item">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div>
              <strong>{item.pain}</strong>
              <p>{item.response}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="scan-story" id="beamcash">
    <div class="scan-story-inner">
      <div class="scan-story-visual motion-item" aria-label="BeamCash screen progression">
        <img class="story-device story-device-dashboard" src="/beamcash/beamcash-app-seller-dashboard.png" alt="BeamCash seller dashboard screen" />
        <img class="story-device story-device-code" src="/beamcash/beamcash-app-seller-code.png" alt="BeamCash seller QR code screen" />
        <img class="story-device story-device-checkout" src="/beamcash/beamcash-app-buyer-checkout.png" alt="BeamCash buyer checkout screen" />
      </div>

      <div class="scan-story-copy motion-item">
        <span>BeamCash product proof</span>
        <h2>Show the payment moment, screen by screen.</h2>
        <p>
          BeamCash turns SkanPay's model into a concrete checkout path that merchants, banks, and payment partners can inspect without guessing.
        </p>

        <div class="story-line-list" aria-label="BeamCash payment walkthrough">
          {beamcashFlow.map((step, index) => (
            <div>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{step}</strong>
            </div>
          ))}
        </div>

        <a class="text-link" href="/beamcash-demo/">Explore the BeamCash page</a>
      </div>
    </div>
  </section>

  <section class="checkout-floor">
    <div class="checkout-floor-inner">
      <div class="checkout-copy motion-item">
        <span>Show, don't tell</span>
        <h2>The buyer sees context before checkout continues.</h2>
        <p>
          The demo focuses on the real trust moment: where the QR appears, what the buyer sees after scanning, and what the seller gets back.
        </p>
        <div class="highlight-lines">
          {beamcashHighlights.slice(0, 3).map((feature) => (
            <div>
              <strong>{feature.title}</strong>
              <p>{feature.copy}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="counter-scene motion-item" aria-label="QR payment counter scene">
        <div class="counter-surface" aria-hidden="true"></div>
        <div class="qr-stand">
          <img src="/beamcash/beamcash-logo-mark.svg" alt="BeamCash logo" />
          <span>BeamCash Demo Stall</span>
          <strong>Scan to Pay</strong>
          <div class="qr-crop">
            <img src="/beamcash/beamcash-app-seller-code.png" alt="BeamCash QR payment request" />
          </div>
        </div>
        <img class="counter-phone" src="/beamcash/beamcash-app-buyer-checkout.png" alt="BeamCash buyer checkout screen" />
        <div class="counter-status">Buyer reviews seller and amount</div>
      </div>
    </div>
  </section>

  <section class="system-blueprint" id="skanpay">
    <div class="system-blueprint-inner">
      <div class="system-copy motion-item">
        <span>SkanPay</span>
        <h2>The infrastructure layer behind the demo.</h2>
        <p>
          SkanPay focuses on request creation, partner routing, payment or redemption coordination, and result states that can support merchant review.
        </p>
      </div>

      <div class="blueprint-rail" aria-label="SkanPay checkout direction">
        {skanpayFlow.map((step, index) => (
          <article class="motion-item">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{step}</strong>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="company-split">
    <div class="company-split-inner">
      <div class="company-split-heading motion-item">
        <span>Company and product</span>
        <h2>SkanPay is the platform direction. BeamCash is the proof.</h2>
        <p>That separation keeps the website clear: BeamCash demonstrates payment competence; SkanPay frames the larger checkout and redemption opportunity.</p>
      </div>
      <div class="split-ledger">
        {productDirections.map((product) => (
          <article class="motion-item">
            <span>{product.name}</span>
            <h3>{product.label}</h3>
            <p>{product.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="final-cta" id="contact">
    <div class="final-cta-inner">
      <div>
        <span>Next step</span>
        <h2>Review the payment flow with us.</h2>
        <p>Share a seller workflow, merchant use case, or payment partner question.</p>
      </div>
      <div class="cta-group">
        <a class="button primary" href={CONTACT_URL}>Contact SkanPay</a>
        <a class="button ghost" href={INTEREST_LIST_URL}>Join interest list</a>
      </div>
    </div>
  </section>
</BaseLayout>
