---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  CONTACT_URL,
  INTEREST_LIST_URL,
  PRODUCT_STATUS,
  beamcashFlow,
  beamcashHighlights,
  painSolutions,
  productDirections,
  skanpayFlow
} from "../content/site";
---
<BaseLayout
  title="SkanPay - BeamCash QR Payments"
  description="SkanPay is developing QR checkout infrastructure. BeamCash is the product demo showing seller QR, buyer review, and checkout status."
  activePath="/"
>
  <section class="landing-hero">
    <div class="hero-inner">
      <div class="hero-content">
        <p class="hero-eyebrow">SkanPay + BeamCash</p>
        <h1>Make the QR payment handoff obvious.</h1>
        <p class="hero-subhead">
          SkanPay is developing patent-pending QR checkout infrastructure. BeamCash is the product proof: a seller QR, buyer review screen, and seller-readable status.
        </p>

        <div class="hero-proof">
          <span>Display QR</span>
          <span>Review amount</span>
          <span>Return status</span>
        </div>

        <div class="hero-actions">
          <a class="button primary" href="/beamcash-demo/">View BeamCash</a>
          <a class="button secondary" href={CONTACT_URL}>Contact SkanPay</a>
        </div>

        <div class="status-note">
          <span>{PRODUCT_STATUS.label}</span>
          <p>{PRODUCT_STATUS.detail}</p>
        </div>
      </div>

      <aside class="hero-product" aria-label="BeamCash prototype screens">
        <div class="product-stage">
          <div class="product-stage-header">
            <div>
              <img class="beamcash-brand-icon" src="/beamcash/beamcash-logo-mark.svg" alt="BeamCash logo" />
              <span>BeamCash demo</span>
            </div>
            <strong>QR request active</strong>
          </div>

          <div class="phone-cluster">
            <img class="phone-shot-main" src="/beamcash/beamcash-app-seller-dashboard.png" alt="BeamCash seller dashboard with Scan to Pay QR code" />
            <div class="request-card" aria-label="QR request summary">
              <span>Seller code</span>
              <strong>Scan to Pay</strong>
              <p>Merchant and amount context stay attached to the request.</p>
            </div>
            <img class="phone-shot-secondary" src="/beamcash/beamcash-app-buyer-checkout.png" alt="BeamCash checkout screen with merchant profile and payment amount options" />
          </div>

          <div class="status-strip" aria-label="BeamCash checkout sequence">
            {beamcashFlow.slice(0, 3).map((step, index) => (
              <div>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{step}</strong>
              </div>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="section pain-section">
    <div class="section-inner">
      <div class="section-heading split-heading">
        <div>
          <span>The problem</span>
          <h2>QR payments fail when the handoff is unclear.</h2>
        </div>
        <p>
          A QR code is easy to display. The harder part is giving sellers, buyers, and partners the right context at the right moment.
        </p>
      </div>
      <div class="pain-grid problem-grid">
        {painSolutions.map((item, index) => (
          <article>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{item.pain}</strong>
            <p>{item.response}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section beamcash-section" id="beamcash">
    <div class="section-inner">
      <div class="section-heading split-heading">
        <div>
          <span>BeamCash product proof</span>
          <h2>Show the flow instead of describing it.</h2>
        </div>
        <p>
          BeamCash turns SkanPay's checkout model into screens that sellers, merchants, and payment partners can review.
        </p>
      </div>

      <div class="walkthrough-grid" aria-label="BeamCash payment walkthrough">
        <article>
          <img src="/beamcash/beamcash-app-seller-dashboard.png" alt="BeamCash seller dashboard screen" />
          <span>Seller</span>
          <h3>Open the request</h3>
          <p>The seller can see the active payment surface before presenting the code.</p>
        </article>
        <article>
          <img src="/beamcash/beamcash-app-seller-code.png" alt="BeamCash seller Scan to Pay QR code screen" />
          <span>QR</span>
          <h3>Display the code</h3>
          <p>The buyer scans a clear Scan to Pay request tied to the seller.</p>
        </article>
        <article>
          <img src="/beamcash/beamcash-app-buyer-checkout.png" alt="BeamCash buyer checkout screen" />
          <span>Buyer</span>
          <h3>Review before checkout</h3>
          <p>The buyer sees merchant and amount context before continuing.</p>
        </article>
      </div>

      <div class="feature-row">
        {beamcashHighlights.map((feature) => (
          <article>
            <h3>{feature.title}</h3>
            <p>{feature.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section skanpay-section" id="skanpay">
    <div class="section-inner skanpay-layout">
      <div class="section-heading">
        <span>SkanPay</span>
        <h2>The infrastructure idea behind the demo.</h2>
        <p>
          SkanPay focuses on the request, routing, and result states that make QR checkout supportable for merchant and partner conversations.
        </p>
      </div>

      <div class="platform-flow" aria-label="SkanPay checkout direction">
        {skanpayFlow.map((step, index) => (
          <article>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{step}</strong>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section use-case-section">
    <div class="section-inner">
      <div class="section-heading split-heading">
        <div>
        <span>Where it fits</span>
          <h2>Company layer and product proof.</h2>
        </div>
        <p>BeamCash helps people see the current payment experience. SkanPay frames the larger checkout and redemption opportunity.</p>
      </div>
      <div class="fit-grid">
        {productDirections.map((product) => (
          <article>
            <span>{product.name}</span>
            <h3>{product.label}</h3>
            <p>{product.description}</p>
            <ul>
              {product.bestFor.slice(0, 4).map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="final-cta" id="contact">
    <div class="final-cta-inner">
      <div>
        <span>Next step</span>
        <h2>Review the QR checkout handoff.</h2>
        <p>Share a seller workflow, merchant use case, or payment partner question.</p>
      </div>
      <div class="cta-group">
        <a class="button primary" href={CONTACT_URL}>Contact SkanPay</a>
        <a class="button ghost" href={INTEREST_LIST_URL}>Join interest list</a>
      </div>
    </div>
  </section>
</BaseLayout>
