---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  CONTACT_URL,
  checkoutProblems,
  relationshipMap,
  skanpayFlow
} from "../content/site";
---
<BaseLayout
  title="SkanPay - Apply Offers and Pay in One Checkout"
  description="SkanPay helps participating wallets, merchants, and payment partners apply eligible value before final payment. BeamCash is the small-seller QR checkout demo."
  activePath="/"
>
  <section class="product-hero skanpay-home">
    <div class="product-hero-inner">
      <div class="product-hero-copy motion-item">
        <p class="eyebrow">Payment + redemption checkout</p>
        <h1>Apply eligible value before the customer pays.</h1>
        <p class="hero-lede">
          SkanPay is developing a checkout value platform for participating wallets, merchants, payment partners, and promotion programs. The goal is simple: use the value a customer already has, then pay the remaining balance.
        </p>

        <div class="hero-checks" aria-label="SkanPay checkout outcomes">
          <span>Coupon, voucher, gift-card, loyalty, or wallet value</span>
          <span>One checkout moment</span>
          <span>Clear result confirmation</span>
        </div>

        <div class="product-actions">
          <a class="button primary" href="/qr-payments/">Explore SkanPay</a>
          <a class="button secondary" href="/beamcash-demo/">View BeamCash demo</a>
        </div>
      </div>

      <aside class="checkout-scene motion-item" aria-label="SkanPay checkout value scene">
        <div class="checkout-receipt">
          <div class="receipt-topline">
            <span>Merchant checkout</span>
            <strong>Ready</strong>
          </div>
          <div class="receipt-row">
            <span>Subtotal</span>
            <strong>$48.00</strong>
          </div>
          <div class="receipt-row applied">
            <span>Eligible value applied</span>
            <strong>-$15.00</strong>
          </div>
          <div class="receipt-row total">
            <span>Balance to pay</span>
            <strong>$33.00</strong>
          </div>
        </div>

        <div class="checkout-placard">
          <span>Scan to review</span>
          <img src="/beamcash/beamcash-app-seller-code.png" alt="BeamCash seller QR checkout screen" />
        </div>

        <img class="checkout-phone" src="/beamcash/beamcash-app-buyer-checkout.png" alt="BeamCash buyer checkout review screen" />

        <div class="checkout-confirmation">
          <span>Confirmation</span>
          <strong>Value applied. Payment completed.</strong>
        </div>
      </aside>
    </div>
  </section>

  <section class="step-band" aria-label="SkanPay checkout flow">
    <div class="step-band-inner">
      {skanpayFlow.map((step, index) => (
        <article class="motion-item">
          <span>{String(index + 1).padStart(2, "0")}</span>
          <strong>{step}</strong>
        </article>
      ))}
    </div>
  </section>

  <section class="problem-led-section">
    <div class="product-section-inner">
      <div class="section-intro motion-item">
        <span>The payment problem</span>
        <h2>Checkout is where stored value gets lost.</h2>
        <p>A customer may have value in one place while the invoice, merchant rules, and payment path live somewhere else.</p>
      </div>

      <div class="editorial-lines" aria-label="Checkout problems and SkanPay responses">
        {checkoutProblems.map((item, index) => (
          <article class="motion-item">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div>
              <strong>{item.problem}</strong>
              <p>{item.solution}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="product-split-section">
    <div class="product-split-inner">
      <div class="section-intro motion-item">
        <span>Company and demo</span>
        <h2>SkanPay is the platform direction. BeamCash is the proof.</h2>
        <p>BeamCash makes one QR checkout moment visible, while SkanPay is the broader path for partner checkout value.</p>
      </div>

      <div class="relationship-ledger" aria-label="SkanPay and BeamCash relationship">
        {relationshipMap.map((item, index) => (
          <article class="motion-item">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{item.name}</strong>
            <em>{item.role}</em>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="beam-proof-section">
    <div class="beam-proof-inner">
      <div class="beam-proof-visual motion-item" aria-label="BeamCash product screens">
        <img src="/beamcash/beamcash-app-seller-dashboard.png" alt="BeamCash seller dashboard screen" />
        <img src="/beamcash/beamcash-app-seller-code.png" alt="BeamCash seller QR code screen" />
        <img src="/beamcash/beamcash-app-buyer-checkout.png" alt="BeamCash buyer review screen" />
      </div>

      <div class="beam-proof-copy motion-item">
        <span>BeamCash demo</span>
        <h2>A visible QR checkout for sellers and buyers.</h2>
        <p>
          BeamCash helps us test setup, scan behavior, buyer review, seller confirmation, and the practical details that payment partners care about.
        </p>
        <a class="text-link" href="/beamcash-demo/">Explore BeamCash</a>
      </div>
    </div>
  </section>

  <section class="final-cta" id="contact">
    <div class="final-cta-inner">
      <div>
        <span>Next step</span>
        <h2>Have a checkout or redemption problem to test?</h2>
        <p>Share the wallet, merchant, offer, or seller workflow you want to make simpler.</p>
      </div>
      <div class="cta-group">
        <a class="button primary" href={CONTACT_URL}>Contact SkanPay</a>
        <a class="button ghost" href="/beamcash-demo/">View BeamCash demo</a>
      </div>
    </div>
  </section>
</BaseLayout>
