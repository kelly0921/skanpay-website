---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  CONTACT_URL,
  INTEREST_LIST_URL,
  PRODUCT_STATUS,
  beamcashFlow,
  beamcashHighlights,
  painSolutions,
  productDirections,
  skanpayFlow
} from "../content/site";
---
<BaseLayout
  title="SkanPay - BeamCash QR Payments"
  description="SkanPay is developing QR checkout infrastructure. BeamCash is the product demo showing seller QR, buyer review, and checkout status."
  activePath="/"
>
  <section class="premium-hero">
    <div class="premium-hero-inner">
      <div class="premium-hero-copy motion-item">
        <p class="brand-kicker">SkanPay infrastructure / BeamCash proof</p>
        <h1>QR checkout that shows what happens after the scan.</h1>
        <p class="premium-lead">
          SkanPay is developing patent-pending QR checkout infrastructure. BeamCash makes the flow visible: display a seller QR, let the buyer review the amount, and return a seller-readable status.
        </p>

        <div class="premium-actions">
          <a class="button primary premium-primary" href="/beamcash-demo/">View BeamCash</a>
          <a class="button secondary premium-secondary" href={CONTACT_URL}>Contact SkanPay</a>
        </div>

        <div class="hero-proof proof-row">
          <span>Display QR</span>
          <span>Review amount</span>
          <span>Return status</span>
        </div>

        <p class="product-status-line">{PRODUCT_STATUS.detail}</p>
      </div>

      <aside class="payment-scene motion-item" aria-label="BeamCash QR checkout scene">
        <div class="scene-panel">
          <div class="scene-topbar">
            <div>
              <img src="/beamcash/beamcash-logo-mark.svg" alt="BeamCash logo" />
              <span>BeamCash request</span>
            </div>
            <strong>Live demo</strong>
          </div>

          <div class="scene-grid">
            <img class="scene-phone scene-phone-seller" src="/beamcash/beamcash-app-seller-code.png" alt="BeamCash seller Scan to Pay QR code screen" />
            <div class="scene-copy-card">
              <span>Scan to Pay</span>
              <strong>Seller code is open</strong>
              <p>Merchant identity, amount context, and request state travel together.</p>
            </div>
            <img class="scene-phone scene-phone-buyer" src="/beamcash/beamcash-app-buyer-checkout.png" alt="BeamCash buyer checkout screen with merchant and amount review" />
          </div>

          <div class="scene-status">
            {beamcashFlow.slice(0, 3).map((step, index) => (
              <div>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{step}</strong>
              </div>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="proof-band">
    <div class="proof-band-inner">
      <div>
        <span>The payment problem</span>
        <h2>A scan alone is not enough.</h2>
      </div>
      <div class="proof-problems">
        {painSolutions.map((item, index) => (
          <article class="motion-item">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{item.pain}</strong>
            <p>{item.response}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="product-story" id="beamcash">
    <div class="product-story-inner">
      <div class="story-copy motion-item">
        <span>BeamCash product proof</span>
        <h2>Show the payment moment, screen by screen.</h2>
        <p>
          BeamCash turns the SkanPay model into a concrete checkout path that sellers, merchants, and payment partners can evaluate.
        </p>
        <a class="text-link" href="/beamcash-demo/">Explore the BeamCash page</a>
      </div>

      <div class="story-steps" aria-label="BeamCash payment walkthrough">
        <article class="motion-item">
          <img src="/beamcash/beamcash-app-seller-dashboard.png" alt="BeamCash seller dashboard screen" />
          <div>
            <span>01 / Seller</span>
            <h3>Open the request</h3>
            <p>The seller starts from a simple dashboard and opens the payment code.</p>
          </div>
        </article>
        <article class="motion-item">
          <img src="/beamcash/beamcash-app-seller-code.png" alt="BeamCash seller Scan to Pay QR code screen" />
          <div>
            <span>02 / QR</span>
            <h3>Display the code</h3>
            <p>The buyer scans a request tied to the seller and payment context.</p>
          </div>
        </article>
        <article class="motion-item">
          <img src="/beamcash/beamcash-app-buyer-checkout.png" alt="BeamCash buyer checkout screen" />
          <div>
            <span>03 / Buyer</span>
            <h3>Review before checkout</h3>
            <p>The buyer sees merchant and amount context before continuing.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="payment-moment">
    <div class="payment-moment-inner">
      <div class="moment-visual motion-item" aria-label="BeamCash QR display concept">
        <div class="counter-card">
          <img src="/beamcash/beamcash-logo-mark.svg" alt="BeamCash logo" />
          <strong>Scan to Pay</strong>
          <p>BeamCash Demo Stall</p>
          <div class="qr-window">
            <img src="/beamcash/beamcash-app-seller-code.png" alt="BeamCash QR payment screen" />
          </div>
        </div>
        <div class="buyer-mini-card">
          <span>Buyer screen</span>
          <strong>Review amount first</strong>
        </div>
      </div>

      <div class="moment-copy motion-item">
        <span>Show, don't tell</span>
        <h2>Make the payment context visible before money moves.</h2>
        <p>
          BeamCash is useful because the demo makes trust moments inspectable: where the QR appears, what the buyer sees, and what the seller gets back.
        </p>
        <div class="moment-list">
          {beamcashHighlights.map((feature) => (
            <div>
              <strong>{feature.title}</strong>
              <p>{feature.copy}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="skanpay-system" id="skanpay">
    <div class="skanpay-system-inner">
      <div class="system-copy motion-item">
        <span>SkanPay</span>
        <h2>The infrastructure layer behind the demo.</h2>
        <p>
          SkanPay focuses on request creation, payment or redemption routing, and result states that can support merchant and partner review.
        </p>
      </div>

      <div class="system-flow" aria-label="SkanPay checkout direction">
        {skanpayFlow.map((step, index) => (
          <article class="motion-item">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{step}</strong>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section use-case-section refined-fit">
    <div class="section-inner">
      <div class="section-heading split-heading">
        <div>
        <span>Where it fits</span>
          <h2>One company layer. One product proof.</h2>
        </div>
        <p>BeamCash helps people see the current payment experience. SkanPay frames the larger checkout and redemption opportunity.</p>
      </div>
      <div class="fit-grid">
        {productDirections.map((product) => (
          <article class="motion-item">
            <span>{product.name}</span>
            <h3>{product.label}</h3>
            <p>{product.description}</p>
            <ul>
              {product.bestFor.slice(0, 4).map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="final-cta" id="contact">
    <div class="final-cta-inner">
      <div>
        <span>Next step</span>
        <h2>Review the payment flow with us.</h2>
        <p>Share a seller workflow, merchant use case, or payment partner question.</p>
      </div>
      <div class="cta-group">
        <a class="button primary" href={CONTACT_URL}>Contact SkanPay</a>
        <a class="button ghost" href={INTEREST_LIST_URL}>Join interest list</a>
      </div>
    </div>
  </section>
</BaseLayout>
