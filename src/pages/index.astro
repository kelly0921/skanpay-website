---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  CONTACT_URL,
  FEEDBACK_FORM_URL,
  INTEREST_LIST_URL,
  PRODUCT_STATUS,
  beamcashFlow,
  beamcashHighlights,
  faqs,
  painSolutions,
  productDirections,
  roadmapItems,
  skanpayFlow
} from "../content/site";
---
<BaseLayout
  title="SkanPay - BeamCash QR Payments"
  description="SkanPay is developing QR checkout infrastructure. BeamCash is the product demo showing seller QR, buyer review, and checkout status."
  activePath="/"
>
  <section class="landing-hero">
    <div class="hero-inner">
      <div class="hero-content">
        <p class="hero-eyebrow">SkanPay presents BeamCash</p>
        <h1>A clearer QR payment handoff from scan to confirmation.</h1>
        <p class="hero-subhead">
          SkanPay is building patent-pending QR checkout infrastructure. BeamCash is the product demo that shows a seller code, buyer amount review, and seller-ready status.
        </p>

        <div class="hero-proof">
          <span>Seller QR</span>
          <span>Buyer review</span>
          <span>Payment states</span>
        </div>

        <div class="hero-actions">
          <a class="button primary" href={INTEREST_LIST_URL}>Join interest list</a>
          <a class="button secondary" href="/beamcash-demo/">View BeamCash demo</a>
        </div>

        <div class="status-note">
          <span>{PRODUCT_STATUS.label}</span>
          <p>{PRODUCT_STATUS.detail}</p>
        </div>
      </div>

      <aside class="hero-product" aria-label="BeamCash prototype screens">
        <div class="product-window">
          <div class="product-window-top">
            <img class="beamcash-brand-icon" src="/beamcash/beamcash-logo-mark.svg" alt="BeamCash logo" />
            <span>BeamCash payment demo</span>
          </div>
          <div class="payment-rail" aria-label="BeamCash payment status preview">
            <div><span>Seller</span><strong>QR active</strong></div>
            <div><span>Buyer</span><strong>Amount review</strong></div>
            <div><span>Status</span><strong>Ready</strong></div>
          </div>
          <div class="screen-showcase">
            <img src="/beamcash/beamcash-app-seller-dashboard.png" alt="BeamCash seller dashboard with Scan to Pay QR code" />
            <img src="/beamcash/beamcash-app-buyer-checkout.png" alt="BeamCash checkout screen with merchant profile and payment amount options" />
          </div>
          <div class="product-steps" aria-label="BeamCash checkout sequence">
            <span>Display</span>
            <span>Review</span>
            <span>Status</span>
          </div>
          <p>Updated BeamCash screens showing the seller request and buyer checkout surface.</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section pain-section">
    <div class="section-inner">
      <div class="section-heading">
        <span>The problem</span>
        <h2>Small payments still need a trusted handoff.</h2>
        <p>BeamCash narrows the moment to what matters: who is paying, what amount is requested, and what status returns.</p>
      </div>
      <div class="pain-grid">
        {painSolutions.map((item) => (
          <article>
            <strong>{item.pain}</strong>
            <p>{item.response}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section beamcash-section" id="beamcash">
    <div class="section-inner beamcash-layout">
      <div class="beamcash-visual single-screen" aria-label="BeamCash seller dashboard preview">
        <img src="/beamcash/beamcash-app-seller-code.png" alt="BeamCash seller Scan to Pay QR code screen" />
      </div>

      <div>
        <div class="section-heading">
          <span>BeamCash</span>
          <h2>Screens make the payment handoff visible.</h2>
          <p>
            A seller displays a Scan to Pay code. The buyer reviews merchant context and amount. The seller gets a status they can act on.
          </p>
        </div>

        <div class="flow-list compact-flow" aria-label="BeamCash flow">
          {beamcashFlow.map((step, index) => (
            <div>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{step}</strong>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="section-inner feature-row">
      {beamcashHighlights.map((feature) => (
        <article>
          <h3>{feature.title}</h3>
          <p>{feature.copy}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section skanpay-section" id="skanpay">
    <div class="section-inner skanpay-layout">
      <div class="section-heading">
        <span>SkanPay</span>
        <h2>A state model for QR checkout infrastructure.</h2>
        <p>
          SkanPay extends the same handoff into partner discussions: request format, payment or redemption path, timeout behavior, and merchant result.
        </p>
      </div>

      <div class="platform-flow" aria-label="SkanPay checkout direction">
        {skanpayFlow.map((step, index) => (
          <article>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{step}</strong>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section use-case-section">
    <div class="section-inner">
      <div class="section-heading">
        <span>Where it fits</span>
        <h2>What belongs where.</h2>
      </div>
      <div class="fit-grid">
        {productDirections.map((product) => (
          <article>
            <span>{product.name}</span>
            <h3>{product.label}</h3>
            <p>{product.description}</p>
            <ul>
              {product.bestFor.slice(0, 4).map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section status-faq-section" id="status">
    <div class="section-inner status-layout">
      <div>
        <div class="section-heading">
          <span>Current status</span>
          <h2>Built demo. Partner review next.</h2>
          <p>
            The current priority is reviewing the seller and buyer handoff with people who understand real checkout.
          </p>
        </div>
        <div class="roadmap-list">
          {roadmapItems.slice(0, 4).map((item) => (
            <div>
              <span>{item.status}</span>
              <strong>{item.title}</strong>
            </div>
          ))}
        </div>
      </div>

      <div>
        <div class="section-heading small-heading">
          <span>FAQ</span>
          <h2>Quick answers.</h2>
        </div>
        <div class="faq-list">
          {faqs.slice(0, 4).map((faq) => (
            <details>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="final-cta" id="contact">
    <div class="final-cta-inner">
      <div>
        <span>Next step</span>
        <h2>Review the QR checkout handoff.</h2>
        <p>Join the interest list, send product feedback, or start a SkanPay partner conversation.</p>
      </div>
      <div class="cta-group">
        <a class="button primary" href={INTEREST_LIST_URL}>Join interest list</a>
        <a class="button secondary" href={FEEDBACK_FORM_URL}>Give feedback</a>
        <a class="button ghost" href={CONTACT_URL}>Contact us</a>
      </div>
    </div>
  </section>
</BaseLayout>
