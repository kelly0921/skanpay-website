---
import "../styles/global.css";
import { CONTACT_EMAIL, INTEREST_LIST_URL, navigationItems } from "../content/site";

const {
  title = "SkanPay - QR Payment Gateway",
  description = "SkanPay helps merchants and payment partners support QR code payment experiences for in-store and mobile wallet transactions.",
  activePath = "/"
} = Astro.props;

const navItems = navigationItems;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://skanpay.us${activePath}`} />
    <meta name="theme-color" content="#102033" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="SkanPay home">
        <img class="brand-logo" src="/skanpay-logo.svg" alt="" aria-hidden="true" />
        <span>SkanPay</span>
      </a>
      <nav class="site-nav" aria-label="Primary navigation">
        {navItems.map((item) => (
          <a href={item.href} aria-current={activePath === item.href ? "page" : undefined}>{item.label}</a>
        ))}
      </nav>
      <a class="header-cta" href={INTEREST_LIST_URL}>Join interest list</a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <a class="brand footer-brand" href="/" aria-label="SkanPay home">
          <img class="brand-logo" src="/skanpay-logo.svg" alt="" aria-hidden="true" />
          <span>SkanPay</span>
        </a>
        <p>SkanPay explores QR-based payment and redemption flows. BeamCash is the small-seller QR payment product under the SkanPay brand.</p>
      </div>
      <div class="footer-links">
        <a href="/#beamcash">BeamCash</a>
        <a href="/#skanpay">SkanPay</a>
        <a href="/#use-cases">Use Cases</a>
        <a href="/privacy/">Privacy</a>
      </div>
      <div>
        <p class="footer-contact">For questions or cooperation:</p>
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      </div>
      <p class="copyright">Copyright &copy; 2026 SkanPay Inc. All rights reserved.</p>
    </footer>
  </body>
</html>
