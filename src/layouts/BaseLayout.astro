---
import "../styles/global.css";
import { CONTACT_EMAIL, INTEREST_LIST_URL, navigationItems } from "../content/site";

const {
  title = "SkanPay - QR Payment Gateway",
  description = "SkanPay helps merchants and payment partners support QR code payment experiences for in-store and mobile wallet transactions.",
  activePath = "/"
} = Astro.props;

const navItems = navigationItems;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://skanpay.us${activePath}`} />
    <meta name="theme-color" content="#102033" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="SkanPay home">
        <img class="brand-logo" src="/skanpay-logo.svg" alt="" aria-hidden="true" />
        <span>SkanPay</span>
      </a>
      <nav class="site-nav" aria-label="Primary navigation">
        {navItems.map((item) => (
          <a href={item.href} aria-current={activePath === item.href ? "page" : undefined}>{item.label}</a>
        ))}
      </nav>
      <a class="header-cta" href={INTEREST_LIST_URL}>Join interest list</a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <a class="brand footer-brand" href="/" aria-label="SkanPay home">
          <img class="brand-logo" src="/skanpay-logo.svg" alt="" aria-hidden="true" />
          <span>SkanPay</span>
        </a>
        <p>SkanPay is developing QR checkout infrastructure. BeamCash is the product demo that shows the seller-to-buyer payment handoff.</p>
      </div>
      <div class="footer-links">
        <a href="/">Home</a>
        <a href="/beamcash-demo/">BeamCash</a>
        <a href="/qr-payments/">Technology</a>
        <a href="/partners/">Partners</a>
        <a href="/about/">About</a>
        <a href="/privacy/">Privacy</a>
      </div>
      <div>
        <p class="footer-contact">For payment or partnership inquiries:</p>
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      </div>
      <p class="copyright">Copyright &copy; 2026 SkanPay Inc. All rights reserved.</p>
    </footer>
    <script is:inline>
      (() => {
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reducedMotion || !("IntersectionObserver" in window)) {
          return;
        }

        const targets = document.querySelectorAll(
          ".section-heading, .pain-grid article, .feature-row article, .platform-flow article, .fit-grid article, .roadmap-list div, .faq-list details, .app-flow-row article, .use-list div, .card, .team-card, .split-panel"
        );

        targets.forEach((target, index) => {
          target.classList.add("reveal");
          target.style.setProperty("--reveal-delay", `${Math.min(index % 6, 5) * 55}ms`);
        });

        document.documentElement.classList.add("motion-ready");

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -12% 0px", threshold: 0.12 }
        );

        targets.forEach((target) => {
          const rect = target.getBoundingClientRect();
          if (rect.top < window.innerHeight && rect.bottom > 0) {
            target.classList.add("is-visible");
            return;
          }
          observer.observe(target);
        });
      })();
    </script>
  </body>
</html>
